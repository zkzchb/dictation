{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dictation-v3",
  "main": "src/worker.py",
  "compatibility_date": "2025-11-02",
  "compatibility_flags": [
    "python_workers",
    "python_dedicated_snapshot"
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dictation-v3",
      "database_id": "4a1f1d60-e5d8-48ee-8e9d-0daf5a1fa2df"
    }
  ],
  "observability": {
    "enabled": true
  }
}
