api.log
*.log
manifest.json
_test*.db
_verify*.py
_check*.js
_inspect*.py

# ── 旧版备份 ───────────────────────────────────────────────────────
*.bak

# ── 操作系统杂项 ───────────────────────────────────────────────────
.DS_Store
Thumbs.db

