# ============================================================================
# Cloudflare 部署配置（V3）—— 复制为 cloudflare.env 后填写
#
#   cp deploy/cloudflare.env.example deploy/cloudflare.env
#   nano deploy/cloudflare.env
#   chmod 600 deploy/cloudflare.env
#   bash deploy/cloudflare-deploy.sh
#
# 本文件含明文密钥，已被 .gitignore 排除，不会提交。
# 注意：V3 全程在本地执行（推到 Cloudflare 边缘），不需要服务器。
# ============================================================================

# ── 可选：有道智云密钥 ───────────────────────────────────────────────────
# 申请：https://ai.youdao.com/
# 仅用于重新生成 TTS。标准 chinese/3a 已随仓库分发，可保留占位符。
YOUDAO_APP_KEY=REPLACE_WITH_YOUDAO_APP_KEY
YOUDAO_APP_SECRET=REPLACE_WITH_YOUDAO_APP_SECRET

# ── D1 数据库 ID ─────────────────────────────────────────────────────────
# 留成占位符时，脚本会自动执行 wrangler d1 create 并把真实 ID 写回
# v3/wrangler.jsonc；若你已手动建库，把 ID 填在这里。
D1_DATABASE_ID=REPLACE_WITH_YOUR_D1_DATABASE_ID

# ============================================================================
# 以下均有合理默认值，一般无需修改
# ============================================================================

# 内容包目录：相对路径从仓库根目录解析，也可使用绝对路径。
CONTENT_ROOT=chinese/3a

# D1 数据库名（与 v3/wrangler.jsonc 的 database_name 一致）
D1_DATABASE_NAME=dictation-v3

# 自定义域名。留空则只用 wrangler 分配的 *.workers.dev 地址。
# 该域名的 DNS 必须已由 Cloudflare 托管。
V3_DOMAIN=v3.dictation.de5.net

# 域名所在的 Cloudflare Zone（通常是主域名）
V3_ZONE=de5.net

# TTS 音色与语速（影响切片内容，改了需重新生成全部切片）
YOUDAO_VOICE=youxiaoxun
YOUDAO_SPEED=0.6

# 切片生成限速（秒）。报 errorCode 411 限流时调大。
TTS_INTERVAL=1.0
