# Dictation V3 Cloudflare configuration
#
#   cp deploy/cloudflare.env.example deploy/cloudflare.env
#   chmod 600 deploy/cloudflare.env
#   bash deploy/cloudflare-deploy.sh --fresh

# External content pack. Relative paths are resolved from the dictation repo.
CONTENT_ROOT=../dictation-content/packs/zh-cn/primary-3a

# Existing/update deployments may set these values. With --fresh, the script
# asks for a new Worker name, uses the same name for a new D1, and rejects an
# existing database ID.
V3_WORKER_NAME=
D1_DATABASE_ID=REPLACE_WITH_YOUR_D1_DATABASE_ID
D1_DATABASE_NAME=

# Existing/update deployments may set a Custom Domain here. With --fresh, the
# script asks interactively; leave the file blank so no private hostname is
# committed or copied into logs by accident.
V3_DOMAIN=
