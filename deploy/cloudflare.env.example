# Dictation V3 Cloudflare configuration
#
#   cp deploy/cloudflare.env.example deploy/cloudflare.env
#   chmod 600 deploy/cloudflare.env
#   bash deploy/cloudflare-deploy.sh

# External content pack. Relative paths are resolved from the dictation repo.
CONTENT_ROOT=../dictation-content/packs/zh-cn/primary-3a

# Leave the ID as a placeholder to let the deployment script create the D1
# database, or provide the UUID of an existing dedicated database.
D1_DATABASE_ID=REPLACE_WITH_YOUR_D1_DATABASE_ID
D1_DATABASE_NAME=dictation-v3

# Optional custom domain. Leave both empty to use the workers.dev URL.
V3_DOMAIN=
V3_ZONE=
