# Dictation V2 low-level VPS configuration
# Normal installations use deploy/install-v2-online.sh, which writes this file.

# Caddy site addresses separated by commas. Examples:
#   http://203.0.113.10
#   dictation.example.com
#   http://203.0.113.10,dictation.example.com
V2_SITE_ADDRESSES=http://203.0.113.10

BASIC_AUTH_USER=REPLACE_WITH_USERNAME
BASIC_AUTH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Keep the program and content repositories as sibling checkouts.
APP_ROOT=/opt/dictation
CONTENT_ROOT=/opt/dictation-content/packs/zh-cn/primary-3a

# Databases, recordings, generated web files and deployment records live here.
STATE_ROOT=/var/lib/dictation

V2_DEPENDENCY_SOURCE=online
V2_PORT=8889
APP_USER=dictation
BACKUP_KEEP_DAYS=30
APP_TIMEZONE=Asia/Shanghai
STUDIO_ENABLED=0
