# Dictation V2 low-level VPS configuration.
#
# Normal installations should run deploy/install-v2-online.sh (main) or
# deploy/install-v2-offline.sh (main-offline). Those entrypoints ask for these
# values interactively and generate deploy/vps.env automatically.

DEPLOY_V1=no
DEPLOY_V2=yes

# Caddy site addresses separated by comma and space. Examples:
#   http://203.0.113.10
#   dictation.example.com
#   http://203.0.113.10, dictation.example.com, dictation-backup.example.com
V2_SITE_ADDRESSES=http://203.0.113.10

# main-offline 固定使用 offline；不要改回 online。
V2_DEPENDENCY_SOURCE=offline

BASIC_AUTH_USER=REPLACE_WITH_USERNAME
BASIC_AUTH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

V2_AUDIO_SOURCE=repository
CONTENT_ROOT=chinese/3a
V2_AUDIO_BUNDLE_URL=
V2_AUDIO_BUNDLE_SHA256=

V2_HUMAN_BUNDLE=
V2_HUMAN_BUNDLE_SHA256=

V2_PORT=8889
APP_ROOT=/opt/dictation
APP_USER=dictation
BACKUP_KEEP_DAYS=30
APP_TIMEZONE=Asia/Shanghai
STUDIO_ENABLED=0

