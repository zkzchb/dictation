# ============================================================================
# VPS 部署配置 —— 复制为 vps.env 后填写，再运行 deploy/vps-install.sh
#
#   cp deploy/vps.env.example deploy/vps.env
#   nano deploy/vps.env
#   chmod 600 deploy/vps.env
#
# 本文件含明文密钥，已被 .gitignore 排除，不会提交。
# ============================================================================

# ── 必填 1/4：部署哪些版本 ───────────────────────────────────────────────
# V1 = 运行时调有道 TTS（需 ffmpeg + 密钥）
# V2 = 从教材 JSON 初始化空库，并安装一套版本化的标准音频
DEPLOY_V1=no
DEPLOY_V2=yes

# ── 必填 2/4：域名（须已 A 记录指向本机公网 IP）──────────────────────────
V1_DOMAIN=v1.dictation.de5.net
V2_DOMAIN=v2.dictation.de5.net

# ── 必填 3/4：有道智云密钥 ───────────────────────────────────────────────
# 申请：https://ai.youdao.com/
# V1 运行时合成必需。V2 使用仓库或 release 资源时可保留占位符不改；
# V2_AUDIO_SOURCE=generate 时需要填写。
YOUDAO_APP_KEY=REPLACE_WITH_YOUDAO_APP_KEY
YOUDAO_APP_SECRET=REPLACE_WITH_YOUDAO_APP_SECRET

# ── 必填 4/4：访问口令 ───────────────────────────────────────────────────
# 应用本身没有登录鉴权，全靠 Caddy basic_auth 保护。请务必改成强密码。
BASIC_AUTH_USER=REPLACE_WITH_USERNAME
BASIC_AUTH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ============================================================================
# 以下均有合理默认值，一般无需修改
# ============================================================================

# TTS 音色与语速
YOUDAO_VOICE=youxiaoxun
YOUDAO_SPEED=0.6

# V1 运行时 TTS 限速与重试（报 errorCode 411 限流时调大 INTERVAL）
TTS_MIN_INTERVAL=0.2
TTS_MAX_RETRY=3

# ── V2 标准音频来源 ───────────────────────────────────────────────────────
# repository：直接使用仓库 chinese/3a/tts（当前正式发行默认，真正开箱即用）。
# auto：已有完整音频则保留；否则依次尝试仓库、下载资源包、有道 API。
# release：从版本化资源包安装（教材很大时备用，远程包须填写 SHA-256）。
# generate：在这台 VPS 上调用有道 API 生成 869 个词条和 25 个系统提示音。
# existing：要求运行脚本前已经手工放入完整音频，只做严格校验。
V2_AUDIO_SOURCE=repository
# 可用相对仓库根目录的路径，安装到非 /opt 位置时无需改。
CONTENT_ROOT=chinese/3a
V2_AUDIO_BUNDLE_URL=
V2_AUDIO_BUNDLE_SHA256=
V2_TTS_INTERVAL=1.0
V2_TTS_RETRY=3

# 可选：真人录音覆盖包。它只包含录音台账登记过的 MP3 与必要的真人录音
# 台账，不包含 SQLite 听写历史、Check 结果或待重录词表。可填本地绝对路径、
# file:// URL 或 HTTPS URL。只要配置覆盖包，就必须填写精确 SHA-256。
V2_HUMAN_BUNDLE=
V2_HUMAN_BUNDLE_SHA256=

# 服务监听端口（仅本机回环，由 Caddy 反代）
V1_PORT=8888
V2_PORT=8889

# 部署根目录与系统用户
APP_ROOT=/opt/dictation
APP_USER=dictation

# 每日数据库备份保留天数
BACKUP_KEEP_DAYS=30

# 打卡日期、间隔复习和录音台账使用的业务时区
APP_TIMEZONE=Asia/Shanghai

# ── 录音工作台（V2 的 /studio）─────────────────────────────────────────────
# 1 开启 / 0 关闭。用于邀请老师录真人音频替换 TTS 切片。
#
# VPS 上默认开启，因为这里条件齐备：Caddy 提供 HTTPS（浏览器只在安全
# 上下文允许访问麦克风），basic_auth 挡住陌生人，ffmpeg 已装好可切割录音。
# 录完可改成 0 再重跑脚本关掉。
STUDIO_ENABLED=1
