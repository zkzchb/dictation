# ============================================================================
# 本地 Ubuntu 部署配置 —— 复制为 local.env 后填写，再运行 deploy/local-install.sh
#
#   cp deploy/local.env.example deploy/local.env
#   nano deploy/local.env
#   chmod 600 deploy/local.env
#   bash deploy/local-install.sh
#
# 本文件含明文密钥，已被 .gitignore 排除，不会提交。
# 本地部署的主要目的：生成音频切片（V2/V3 都要用），顺带能在本机试跑。
# ============================================================================

# ── 必填：有道智云密钥 ───────────────────────────────────────────────────
# 申请：https://ai.youdao.com/
# 生成音频切片必需。V1 本地试跑也用它。
YOUDAO_APP_KEY=REPLACE_WITH_YOUDAO_APP_KEY
YOUDAO_APP_SECRET=REPLACE_WITH_YOUDAO_APP_SECRET

# ============================================================================
# 以下均有合理默认值，一般无需修改
# ============================================================================

# 本地要装哪几个版本的运行环境。
# 只想生成切片的话两个都设 no 也可以 —— 脚本会建一个最小环境来跑 gen_slices.py。
SETUP_V1=yes
SETUP_V2=yes

# TTS 音色与语速。
# 注意：改了会导致切片内容变化，需删掉 shared/web/audio/ 重新生成全部切片。
YOUDAO_VOICE=youxiaoxun
YOUDAO_SPEED=0.6

# 切片生成间隔（秒）。有道报 errorCode 411 限流时调大，例如 2.0。
TTS_INTERVAL=1.0

# 切片生成失败重试次数
TTS_RETRY=3

# 本地试跑的监听端口
V1_PORT=8888
V2_PORT=8889

# ── 监听地址 ─────────────────────────────────────────────────────────────
# 127.0.0.1  只有本机能访问（最安全，默认）
# 0.0.0.0    局域网内所有设备可访问 —— 手机、平板拿来听写就选这个
#
# ⚠️ 应用本身没有任何鉴权。设 0.0.0.0 意味着同一网段内任何设备
#    （包括访客手机、智能家居等）都能打开页面、出题、提交成绩。
#    题库和成绩不算敏感，但请确认你信任这个网络环境。
BIND_HOST=127.0.0.1

# ── 录音工作台（V2 的 /studio）─────────────────────────────────────────────
# 1 开启 / 0 关闭。该功能会把上传的录音写入 shared/web/audio/w/。
# BIND_HOST=0.0.0.0 且无鉴权时，强烈建议设 0 —— 平时听写用不到它，
# 需要录音时临时改成 1 并重启服务即可。
STUDIO_ENABLED=1

# 是否预热 V1 缓存（从已生成的 V2 切片复制，零 API 调用）。
# V1 每次听写要连发 40+ 次 TTS 请求，不预热容易被限流。
WARM_V1_CACHE=yes
