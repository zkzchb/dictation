# Dictation V2 local configuration
#
#   cp deploy/local.env.example deploy/local.env
#   bash deploy/local-install.sh

# External content pack. Relative paths are resolved from the dictation repo.
CONTENT_ROOT=../dictation-content/packs/zh-cn/primary-3a

# Writable state is deliberately separate from code and source content.
STATE_ROOT=.runtime/local

V2_PORT=8889
BIND_HOST=127.0.0.1
APP_TIMEZONE=Asia/Shanghai

# The recording studio writes replacement MP3 files into STATE_ROOT.
# When BIND_HOST=0.0.0.0 and no reverse-proxy authentication is configured,
# keep this at 0 unless the local network is trusted.
STUDIO_ENABLED=1
