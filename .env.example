# Dictation V2 runtime example
# Copy only the values you need into your own environment or service file.

# External content pack. The default assumes dictation and dictation-content are
# sibling checkouts.
DICTATION_CONTENT_ROOT=../dictation-content/packs/zh-cn/primary-3a

# Writable runtime state. Keep databases and recordings outside the Git tree in
# production; these relative paths are convenient for a local checkout.
DICTATION_DB=.runtime/v2/dictation.db
WEB_ROOT=.runtime/web
STUDIO_AUDIO_DIR=.runtime/web/audio/w

APP_TIMEZONE=Asia/Shanghai
STUDIO_ENABLED=1
