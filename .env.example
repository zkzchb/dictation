# 听写小助手 环境变量示例
# 复制为 .env 后按需填写：cp .env.example .env
# 所有变量都有默认值，仅在需要覆盖时才填。生产环境建议放到
# /etc/dictation/v1.env、/etc/dictation/v2.env（见 DEPLOY-vps.md 第 7 步）。

# ── 有道智云 TTS（V1 运行时合成 / gen_slices.py 生成切片 用）──────────────
# 控制台申请：https://ai.youdao.com/
YOUDAO_APP_KEY=REPLACE_WITH_YOUDAO_APP_KEY
YOUDAO_APP_SECRET=REPLACE_WITH_YOUDAO_APP_SECRET
# 音色与语速（默认 youxiaoxun / 0.6，一般无需改）
YOUDAO_VOICE=youxiaoxun
YOUDAO_SPEED=0.6

# ── V1：音频与数据库路径（不填则用脚本同目录的相对路径）──────────────────
# AUDIO_OUTPUT_DIR=/opt/dictation/v1/audio
# AUDIO_CACHE_DIR=/opt/dictation/v1/tts_cache
# DICTATION_DB=/opt/dictation/v1/dictation.db

# ── V1 运行时 TTS 限速与重试（被有道限流时可调）───────────────────────────
# TTS_MIN_INTERVAL=0.2
# TTS_MAX_RETRY=3

# ── V2：数据库与静态资源根（不填则用默认相对路径）─────────────────────────
# DICTATION_DB=/opt/dictation/v2/dictation.db
# WEB_ROOT=/opt/dictation/shared/web
# STUDIO_AUDIO_DIR=/opt/dictation/shared/web/audio/w

# ── gen_slices.py：切片生成限速（被有道限流时调大 TTS_INTERVAL）───────────
# TTS_INTERVAL=1.0
# TTS_RETRY=3
# MAX_GROUPS=20
